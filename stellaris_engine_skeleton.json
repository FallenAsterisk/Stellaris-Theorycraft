{
  "description": "Stellaris Engine Skeleton - extended JSON structure for modules, covering all major common/ repo concepts.",
  "version": "skeleton-v2",
  "modules": {
    "01_tech": {
      "description": "Technology data: physics, society, engineering.",
      "schema": {
        "tech_object": {
          "id": "string (e.g. tech.battleships)",
          "name": "string",
          "area": "physics | society | engineering",
          "subfield": "string (e.g. computing, field_manipulation, voidcraft, biology, etc.)",
          "tier": "integer (0-5)",
          "base_cost": "number",
          "prerequisites": [
            "tech id"
          ],
          "unlocks_components": [
            "component id"
          ],
          "unlocks_ships": [
            "ship_hull id"
          ],
          "unlocks_buildings": [
            "building id"
          ],
          "unlocks_districts": [
            "district id"
          ],
          "unlocks_jobs": [
            "job id"
          ],
          "unlocks_traits": [
            "trait id"
          ],
          "unlocks_policies": [
            "policy id"
          ],
          "unlocks_edicts": [
            "edict id"
          ],
          "unlocks_megastructures": [
            "megastructure id"
          ],
          "modifies_rules": [
            "rule id"
          ],
          "tags": [
            "string"
          ]
        }
      },
      "data": {
        "techs": []
      }
    },

    "02_traits": {
      "description": "All traits: biological, machine, cyborg, overtuned, ascension-like species traits, unique.",
      "schema": {
        "trait_object": {
          "id": "string (e.g. trait.industrious)",
          "name": "string",
          "type": "biological | machine | cyborg | overtuned | ascension | unique | pre_sapient",
          "cost": "integer (can be negative)",
          "picks_used": "integer",
          "modifiers": "object (job output, growth, upkeep, habitability, etc.)",
          "conflicts_with": [
            "trait id"
          ],
          "requires": [
            "ids (tech, civic, authority, archetype, etc.)"
          ],
          "tags": [
            "string"
          ]
        }
      },
      "data": {
        "traits": []
      }
    },

    "03_species": {
      "description": "Species archetypes, species rights, population rules.",
      "schema": {
        "species_archetype_object": {
          "id": "string (e.g. archetype.organic)",
          "name": "string",
          "primary_trait": "string (organic | lithoid | thermophile | machine | etc.)",
          "base_upkeep": "object (resource -> amount)",
          "base_growth": "number",
          "base_assembly": "number",
          "habitability_baseline": "object (climate_group -> fraction)",
          "tags": [
            "string"
          ]
        },
        "species_rights_object": {
          "id": "string",
          "name": "string",
          "category": "citizenship | slavery | assimilation | migration | colonization | etc.",
          "effects": "object (political power, jobs allowed, purge type, etc.)",
          "requirements": [
            "ids (ethics, civics, authority, tech, etc.)"
          ]
        },
        "pop_rule_object": {
          "id": "string (e.g. rule.pop_growth_hive)",
          "type": "growth | assembly | habitability | upkeep",
          "formula": "string",
          "affected_by": [
            "ids (traits, buildings, techs, civics, etc.)"
          ]
        }
      },
      "data": {
        "species_archetypes": [],
        "species_rights": [],
        "pop_rules": []
      }
    },

    "04_empire": {
      "description": "Ethics, authorities, civics, policies, edicts, factions, diplomacy, federation, and ascension perks.",
      "schema": {
        "ethic_object": {
          "id": "string",
          "name": "string",
          "axis": "string (materialist, xenophile, etc.)",
          "fanatic": "boolean",
          "modifiers": "object",
          "excludes": [
            "ethic id"
          ],
          "tags": [
            "string"
          ]
        },
        "authority_object": {
          "id": "string",
          "name": "string",
          "modifiers": "object",
          "requirements": [
            "ids (ethics, civics, etc.)"
          ],
          "tags": [
            "string"
          ]
        },
        "civic_object": {
          "id": "string",
          "name": "string",
          "modifiers": "object (empire-wide effects, job changes, etc.)",
          "requirements": [
            "ids (ethics, authority, origin, etc.)"
          ],
          "forbidden_with": [
            "civic id"
          ],
          "tags": [
            "string"
          ]
        },
        "policy_object": {
          "id": "string",
          "name": "string",
          "category": "string (policy group)",
          "options": "array of option objects with modifiers and requirements"
        },
        "edict_object": {
          "id": "string",
          "name": "string",
          "cost": "object (unity, influence, etc.)",
          "modifiers": "object",
          "requirements": [
            "ids (tech, ethics, civics, etc.)"
          ]
        },
        "faction_object": {
          "id": "string",
          "name": "string",
          "ethic": "string (ethic id)",
          "demands": "array of condition descriptors",
          "effects": "object (unity generation, approval impact)"
        },
        "ascension_perk_object": {
          "id": "string",
          "name": "string",
          "modifiers": "object (empire-level bonuses)",
          "requirements": [
            "ids (traditions, techs, situation outcomes, etc.)"
          ],
          "tags": [
            "string"
          ]
        },
        "agreement_object": {
          "id": "string",
          "name": "string",
          "category": "commercial | research | subject | federation | defensive_pact | etc.",
          "terms": [
            "agreement_term id or descriptor"
          ],
          "requirements": [
            "ids (ethics, civics, tech, federation_type, laws, etc.)"
          ],
          "effects": "object (resource transfer, opinion modifiers, subject tax, integration rules, etc.)",
          "tags": [
            "string"
          ]
        },
        "casus_belli_object": {
          "id": "string",
          "name": "string",
          "war_goal_types": [
            "war_goal id"
          ],
          "requirements": [
            "ids (ethics, tech, events, claims, situations)"
          ],
          "effects": "object (warscore modifiers, war_exhaustion, occupation rules, etc.)",
          "tags": [
            "string"
          ]
        },
        "federation_type_object": {
          "id": "string",
          "name": "string",
          "category": "hegemony | militarist | trade | research | spiritual | etc.",
          "modifiers": "object (base cohesion, envoys, empire modifiers)",
          "tags": [
            "string"
          ]
        },
        "federation_law_object": {
          "id": "string",
          "name": "string",
          "federation_type": "string (federation_type id)",
          "category": "string (law branch/category)",
          "effects": "object (cohesion, centralization, envoys, contributions, etc.)",
          "requirements": [
            "ids (cohesion thresholds, previous laws, techs, etc.)"
          ],
          "tags": [
            "string"
          ]
        },
        "galactic_resolution_object": {
          "id": "string",
          "name": "string",
          "category": "string (sanctions, economy, defense, etc.)",
          "effects": "object (empire modifiers when passed)",
          "requirements": [
            "ids (council presence, diplomatic weight, tech, etc.)"
          ],
          "tags": [
            "string"
          ]
        }
      },
      "data": {
        "ethics": [],
        "authorities": [],
        "civics": [],
        "policies": [],
        "edicts": [],
        "factions": [],
        "ascension_perks": [],
        "agreements": [],
        "casus_belli": [],
        "federation_types": [],
        "federation_laws": [],
        "galactic_resolutions": []
      }
    },

    "05_economy": {
      "description": "Buildings, districts, jobs, resources, planet features/modifiers, blockers, economy rules, economic plans and colony automation.",
      "schema": {
        "building_object": {
          "id": "string",
          "name": "string",
          "category": "string (research, alloy, cg, unity, etc.)",
          "tier": "integer",
          "base_cost": "object (resource -> amount)",
          "upkeep": "object",
          "jobs_created": "array of {job_id, count}",
          "prerequisites": [
            "tech id"
          ],
          "upgrades_from": "string or null",
          "planet_restrictions": [
            "tags (habitat_only, hive_only, etc.)"
          ],
          "tags": [
            "string"
          ]
        },
        "district_object": {
          "id": "string",
          "name": "string",
          "type": "city | generator | mining | agriculture | habitat_* etc.",
          "jobs_created": "array of {job_id, count}",
          "planet_types": [
            "planet_class id"
          ],
          "tags": [
            "string"
          ]
        },
        "job_object": {
          "id": "string",
          "name": "string",
          "stratum": "worker | specialist | ruler | drone",
          "inputs": "object (resource -> amount)",
          "outputs": "object",
          "modifiers": "object",
          "tags": [
            "string"
          ]
        },
        "resource_object": {
          "id": "string",
          "name": "string",
          "category": "basic | strategic | special",
          "tags": [
            "string"
          ]
        },
        "planet_modifier_object": {
          "id": "string",
          "name": "string",
          "effects": "object",
          "source": "string (tech, event, feature, etc.)"
        },
        "planet_feature_object": {
          "id": "string",
          "name": "string",
          "effects": "object (district caps, blockers, etc.)",
          "tags": [
            "string"
          ]
        },
        "blocker_object": {
          "id": "string",
          "name": "string",
          "cleared_by": [
            "tech id"
          ],
          "effects": "object"
        },
        "economy_rule_object": {
          "id": "string",
          "formula": "string",
          "affected_by": [
            "ids (traits, civics, buildings, etc.)"
          ]
        },
        "economic_plan_object": {
          "id": "string",
          "name": "string",
          "category": "balanced | research | alloy | unity | trade | etc.",
          "weights": "object (resource or job weights used by AI/economy scripts)",
          "affected_by": [
            "ids (ai_personalities, policies, difficulty_settings, etc.)"
          ],
          "tags": [
            "string"
          ]
        },
        "colony_automation_plan_object": {
          "id": "string",
          "name": "string",
          "category": "string (colony_automation category id)",
          "build_priorities": "array of building/district ids in priority order",
          "conditions": "object (min pops, planet designation, resource thresholds, etc.)",
          "tags": [
            "string"
          ]
        }
      },
      "data": {
        "buildings": [],
        "districts": [],
        "jobs": [],
        "resources": [],
        "planet_modifiers": [],
        "planet_features": [],
        "blockers": [],
        "economy_rules": [],
        "economic_plans": [],
        "colony_automation_plans": []
      }
    },

    "06_military": {
      "description": "Ships, sections, components, armies, mutations, bombardment stances, military rules.",
      "schema": {
        "ship_hull_object": {
          "id": "string",
          "name": "string",
          "size_class": "corvette|destroyer|cruiser|battleship|titan|juggernaut|platform|bio|nanite|fe etc.",
          "base_stats": "object (hull, armor, shields, evasion, speed, etc.)",
          "base_cost": "object (alloys, etc.)",
          "sections": [
            "ship_section id"
          ],
          "unlocked_by": [
            "tech id"
          ],
          "tags": [
            "string"
          ]
        },
        "ship_section_object": {
          "id": "string",
          "name": "string",
          "slots": "array of {slot_type, size}",
          "compatible_hulls": [
            "ship_hull id"
          ],
          "tags": [
            "string"
          ]
        },
        "component_object": {
          "id": "string",
          "name": "string",
          "slot_type": "weapon|utility|core|aux|sensor|thruster|reactor|aura|strike_craft",
          "sizes": [
            "size labels"
          ],
          "stats": "object (damage, tracking, accuracy, modifiers vs armor/shields/hull, etc.)",
          "unlocked_by": [
            "tech id"
          ],
          "requires_resources": "object",
          "tags": [
            "string"
          ]
        },
        "army_object": {
          "id": "string",
          "name": "string",
          "type": "assault|defense|psionic|clone|robotic|bio etc.",
          "stats": "object (damage, morale, health)",
          "unlocked_by": [
            "tech id"
          ],
          "tags": [
            "string"
          ]
        },
        "mutation_object": {
          "id": "string",
          "name": "string",
          "category": "offensive|defensive|special",
          "effects": "object",
          "unlocked_by": [
            "tech id"
          ],
          "tags": [
            "string"
          ]
        },
        "military_rule_object": {
          "id": "string",
          "formula": "string",
          "affected_by": [
            "ids"
          ]
        },
        "bombardment_stance_object": {
          "id": "string",
          "name": "string",
          "damage_to_pops": "number",
          "damage_to_armies": "number",
          "damage_to_planets": "number",
          "requirements": [
            "ids (ethics, civics, policies, techs)"
          ],
          "tags": [
            "string (total_war, selective, etc.)"
          ]
        }
      },
      "data": {
        "ship_hulls": [],
        "ship_sections": [],
        "components": [],
        "armies": [],
        "mutations": [],
        "military_rules": [],
        "bombardment_stances": []
      }
    },

    "07_megastructures": {
      "description": "Megastructures, habitats, orbital rings, crisis megastructures, galaxy features.",
      "schema": {
        "megastructure_object": {
          "id": "string",
          "name": "string",
          "stages": "integer or array",
          "cost": "object",
          "upkeep": "object",
          "effects": "object",
          "prerequisites": [
            "tech id"
          ],
          "planet_restrictions": [
            "tags"
          ],
          "tags": [
            "string"
          ]
        },
        "habitat_object": {
          "id": "string",
          "name": "string",
          "districts_allowed": [
            "district ids"
          ],
          "prerequisites": [
            "tech id"
          ],
          "effects": "object",
          "tags": [
            "string"
          ]
        },
        "orbital_ring_object": {
          "id": "string",
          "name": "string",
          "tier": "1|2|3",
          "modules": [
            "module ids"
          ],
          "prerequisites": [
            "tech id"
          ],
          "effects": "object",
          "tags": [
            "string"
          ]
        },
        "crisis_megastructure_object": {
          "id": "string",
          "name": "string",
          "stages": "integer",
          "effects": "object",
          "requirements": [
            "tech ids or crisis-level triggers"
          ],
          "tags": [
            "string"
          ]
        },
        "galaxy_feature_object": {
          "id": "string",
          "name": "string",
          "effects": "object (system or planet modifiers, travel rules, etc.)",
          "source": "string (e.g. bypass, cosmic_storms, dust_clouds, ambient_objects)",
          "tags": [
            "string (bypass, storm, nebula, etc.)"
          ]
        }
      },
      "data": {
        "megastructures": [],
        "habitats": [],
        "orbital_rings": [],
        "crisis_megastructures": [],
        "galaxy_features": []
      }
    },

    "08_events_situations": {
      "description": "Situations, event tech, relics, archeotech, anomalies, archaeology, espionage operations.",
      "schema": {
        "situation_object": {
          "id": "string",
          "name": "string",
          "category": "string",
          "stages": "array of stage descriptors",
          "effects": "object",
          "requirements": [
            "ids"
          ]
        },
        "event_tech_object": {
          "id": "string",
          "name": "string",
          "unlocked_by": "event chain id",
          "effects": "object",
          "tags": [
            "string"
          ]
        },
        "relic_object": {
          "id": "string",
          "name": "string",
          "effects": "object",
          "activation_cost": "object",
          "tags": [
            "string"
          ]
        },
        "archeotech_object": {
          "id": "string",
          "name": "string",
          "category": "weapon|defense|utility",
          "stats": "object",
          "unlocked_by": [
            "ids"
          ]
        },
        "anomaly_object": {
          "id": "string",
          "name": "string",
          "category": "astral | exploration | archaeology | special_project | etc.",
          "stages": "array of stage descriptors",
          "effects": "object",
          "requirements": [
            "ids (techs, ship_components, empire scope triggers)"
          ],
          "tags": [
            "string"
          ]
        },
        "archaeological_site_object": {
          "id": "string",
          "name": "string",
          "stages": "array of stage descriptors",
          "rewards": "object (relics, resources, modifiers, archeotech, etc.)",
          "requirements": [
            "ids (events, anomalies, origins)"
          ],
          "tags": [
            "string (dig_site, precursor, etc.)"
          ]
        },
        "espionage_operation_object": {
          "id": "string",
          "name": "string",
          "category": "string (sabotage, intel, asset_acquisition, etc.)",
          "stages": "array of stage descriptors",
          "requirements": [
            "ids (intel_levels, assets, traditions, civics, etc.)"
          ],
          "effects": "object (modifiers, events, resource swings)",
          "tags": [
            "string"
          ]
        }
      },
      "data": {
        "situations": [],
        "event_tech": [],
        "relics": [],
        "archeotech": [],
        "anomalies": [],
        "archaeological_sites": [],
        "espionage_operations": []
      }
    },

    "09_rules": {
      "description": "Global rules: population, economy, combat, research, diplomacy, empire size, AI, intel, crisis.",
      "schema": {
        "rule_object": {
          "id": "string (e.g. rule.pop_growth_base)",
          "type": "population|economy|combat|research|diplomacy|empire|ai|intel|crisis",
          "formula": "string",
          "affected_by": [
            "ids (traits, civics, techs, policies, agreements, etc.)"
          ],
          "notes": "string"
        }
      },
      "data": {
        "rules": []
      }
    },

    "10_metadata": {
      "description": "Engine-level metadata, indices, achievements, and game concepts.",
      "schema": {
        "metadata_object": {
          "id": "string",
          "value": "any"
        },
        "achievement_object": {
          "id": "string",
          "name": "string",
          "description": "string",
          "requirements": [
            "ids (events, techs, empires states, etc.)"
          ],
          "tags": [
            "string (steam, in_game, meta)"
          ]
        },
        "game_concept_object": {
          "id": "string",
          "name": "string",
          "category": "string (tutorial, advanced_mechanic, UI_help, etc.)",
          "description": "string",
          "links": [
            "ids (rules, techs, traits, etc.)"
          ],
          "tags": [
            "string"
          ]
        }
      },
      "data": {
        "metadata": [],
        "achievements": [],
        "game_concepts": [],
        "modules_list": [
          "01_tech",
          "02_traits",
          "03_species",
          "04_empire",
          "05_economy",
          "06_military",
          "07_megastructures",
          "08_events_situations",
          "09_rules",
          "10_metadata"
        ]
      }
    }
  }
}
